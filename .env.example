# FormX Consultants — form delivery configuration
# Copy to `.env.local` and fill in before go-live. Never commit real secrets.

# Required for live email delivery. Get one at https://resend.com.
# Without it, forms fall back to server-side logging (safe for local dev).
RESEND_API_KEY=

# Verified sender in Resend (must match a verified domain), e.g.
# "FormX Consultants <contact@formxconsultants.com>"
RESEND_FROM_EMAIL=

# Where contact / newsletter / vendor submissions are delivered. Defaults to
# inquiry@formxconsultants.com when unset.
CONTACT_EMAIL=
